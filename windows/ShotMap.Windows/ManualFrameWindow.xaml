<Window x:Class="ShotMap.Windows.ManualFrameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="手动选帧" Width="1280" Height="830" MinWidth="1000" MinHeight="710"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#F7F8FA"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="12" Foreground="#202124"
        Loaded="OnLoaded" Closing="CancelActiveRead" PreviewKeyDown="EditorKeys"
        UseLayoutRounding="True" Language="zh-CN">
    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#0A66D9" />
        <SolidColorBrush x:Key="Divider" Color="#1F000000" />
        <SolidColorBrush x:Key="MediaWell" Color="#EFF2F6" />
        <BooleanToVisibilityConverter x:Key="VisibleWhen" />
        <Style x:Key="Action" TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource Divider}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#202124" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Face" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Opacity" Value=".88" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Face" Property="Opacity" Value=".8" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Face" Property="Opacity" Value=".45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Action}">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="BorderBrush" Value="#2EFFFFFF" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="SmallSurface" TargetType="Button" BasedOn="{StaticResource Action}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="SmallFace" CornerRadius="5" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="SmallFace" Property="Opacity" Value=".8" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="SmallFace" Property="Opacity" Value=".45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MarkerBadge" TargetType="Button" BasedOn="{StaticResource SmallSurface}">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="Step" TargetType="Button" BasedOn="{StaticResource Action}">
            <Setter Property="Width" Value="44" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="1.5,0" />
        </Style>
        <DataTemplate x:Key="StepText">
            <TextBlock LineHeight="14"><Run Text="{Binding Mode=OneWay}" FontFamily="Consolas" FontSize="12" FontWeight="SemiBold" /><Run Text=" 帧" FontSize="9" Foreground="#696B70" /></TextBlock>
        </DataTemplate>
        <Style x:Key="Tile" TargetType="Button">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter x:Name="Card" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Card" Property="Opacity" Value=".45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Scrubber" TargetType="Slider">
            <Setter Property="Height" Value="18" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center" Height="18">
                            <Border Height="2" Background="{StaticResource Divider}" CornerRadius="1" />
                            <Border x:Name="ScrubProgress" Height="2" Width="{Binding ProgressWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                                    HorizontalAlignment="Left" Background="{StaticResource Accent}" CornerRadius="1" />
                            <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                                   Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template><ControlTemplate><Border Background="Transparent" /></ControlTemplate></RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template><ControlTemplate><Border Background="Transparent" /></ControlTemplate></RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="12" Height="12">
                                        <Thumb.Template>
                                            <ControlTemplate><Ellipse Fill="White" Stroke="{StaticResource Accent}" StrokeThickness="2" /></ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root" SizeChanged="LayoutChanged">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid x:Name="Workspace" Background="#F8F9FA" Height="322">
            <Grid Margin="16,12">
                <Grid.ColumnDefinitions><ColumnDefinition x:Name="MonitorWidth" Width="548" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border x:Name="Monitor" Background="{StaticResource MediaWell}" BorderBrush="{StaticResource Divider}" BorderThickness="1" CornerRadius="8"
                        SizeChanged="ClipRoundedBorder">
                    <Grid>
                        <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Close" Stretch="Uniform"
                                      MediaOpened="PlaybackOpened" MediaEnded="PlaybackEnded" MediaFailed="PlaybackFailed" Visibility="Hidden" />
                        <Image x:Name="FramePreview" Stretch="Uniform" AutomationProperties.Name="画面预览" />
                        <Border x:Name="Notice" Visibility="Collapsed" Background="#DFFFFFFF" CornerRadius="6" Padding="10,6"
                                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="8,8,8,12">
                            <TextBlock x:Name="ReadStatus" TextWrapping="Wrap" Foreground="#383B40" AutomationProperties.LiveSetting="Polite" />
                        </Border>
                    </Grid>
                </Border>
                <Border Grid.Column="2" Background="White" CornerRadius="8" BorderBrush="{StaticResource Divider}" BorderThickness="1" Padding="12">
                    <Grid x:Name="TimelineDeck">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="36" /><RowDefinition Height="8" /><RowDefinition Height="Auto" /><RowDefinition Height="*" />
                            <RowDefinition Height="6" /><RowDefinition Height="46" /><RowDefinition Height="1" /><RowDefinition Height="8" />
                            <RowDefinition Height="30" />
                        </Grid.RowDefinitions>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="CancelButton" Content="取消" IsCancel="True" Style="{StaticResource Action}" Width="64" Margin="0,0,6,0" />
                                <Button x:Name="ApplyButton" Content="保存" Click="Apply" Style="{StaticResource Primary}" Width="76" ToolTip="保存到当前分镜，返回后可导出" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="PlayButton" Click="TogglePlayback" Style="{StaticResource SmallSurface}" Width="28" Padding="0"
                                        Background="#140A66D9" BorderThickness="0" AutomationProperties.Name="播放" ToolTip="播放">
                                    <Viewbox Width="15" Height="15">
                                        <Canvas Width="24" Height="24">
                                            <!-- Tabler Icons Outline player-play and player-pause, MIT. -->
                                            <Path x:Name="PlayGlyph" Data="M7 4v16l13 -8l-13 -8" Stroke="{StaticResource Accent}" StrokeThickness="2"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                        </Canvas>
                                    </Viewbox>
                                </Button>
                                <TextBlock x:Name="SelectionCount" FontSize="28" FontWeight="Bold" Foreground="{StaticResource Accent}" VerticalAlignment="Center"
                                           TextAlignment="Center" Margin="6,0" MinWidth="62" Typography.NumeralAlignment="Tabular" />
                                <Button x:Name="SmartButton" Content="智能选帧" Click="SmartFill" Style="{StaticResource Action}"
                                        Margin="0,0,6,0" ToolTip="保留已选画面，智能补齐剩余" />
                                <Button x:Name="ShuffleButton" Content="换一批" Click="Regenerate" Style="{StaticResource Action}"
                                        ToolTip="换一批候选并清空当前选择" />
                            </StackPanel>
                        </DockPanel>
                        <Canvas x:Name="SelectionMarks" Grid.Row="2" Height="24" SizeChanged="TimelineGeometryChanged" />
                        <Border x:Name="FilmstripBorder" Grid.Row="3" CornerRadius="4" Background="{StaticResource MediaWell}" SizeChanged="ClipRoundedBorder">
                            <Grid x:Name="FilmstripArea" SizeChanged="TimelineGeometryChanged">
                                <ItemsControl x:Name="Filmstrip" IsHitTestVisible="False">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,1,0">
                                                <Border.Background><ImageBrush ImageSource="{Binding Image}" Stretch="UniformToFill" /></Border.Background>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Canvas x:Name="FilmstripLines" IsHitTestVisible="False" />
                                <Border Background="Transparent" Cursor="Hand" MouseLeftButtonDown="FilmstripClicked" />
                            </Grid>
                        </Border>
                        <Grid Grid.Row="5">
                            <Grid.RowDefinitions><RowDefinition Height="18" /><RowDefinition Height="1" /><RowDefinition Height="6" />
                                <RowDefinition Height="1" /><RowDefinition Height="12" /><RowDefinition Height="8" /></Grid.RowDefinitions>
                            <Slider x:Name="Timeline" Style="{StaticResource Scrubber}" ValueChanged="TimelineChanged"
                                    AutomationProperties.Name="视频时间轴" SmallChange=".1" LargeChange="2" />
                            <Canvas x:Name="Ticks" Grid.Row="2" SizeChanged="TimelineGeometryChanged" IsHitTestVisible="False" />
                            <TextBlock Grid.Row="4" Text="00:00:00" FontFamily="Consolas" FontSize="10" Foreground="#64666B" />
                            <TextBlock Grid.Row="4" x:Name="EndTime" HorizontalAlignment="Right" FontFamily="Consolas" FontSize="10" Foreground="#64666B" />
                            <Canvas Grid.RowSpan="6" x:Name="AddTrack">
                                <Button x:Name="AddButton" Canvas.Top="20" Content="添加当前帧" Click="AddCurrentFrame" Style="{StaticResource Action}"
                                        Height="26" Padding="12,0" Background="#EBF3FC" Foreground="{StaticResource Accent}" BorderBrush="#240A66D9"
                                        FontWeight="SemiBold" ToolTip="把当前画面加入候选图卡">
                                    <Button.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity=".1" Direction="270" /></Button.Effect>
                                </Button>
                            </Canvas>
                        </Grid>
                        <Border Grid.Row="6" Background="{StaticResource Divider}" />
                        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button x:Name="BackFive" Style="{StaticResource Step}" Content="−5" ContentTemplate="{StaticResource StepText}" Click="StepFrame" Tag="-5" ToolTip="后退五帧" />
                            <Button x:Name="BackOne" Style="{StaticResource Step}" Content="−1" ContentTemplate="{StaticResource StepText}" Click="StepFrame" Tag="-1" ToolTip="后退一帧" />
                            <Border CornerRadius="8" BorderBrush="{StaticResource Divider}" BorderThickness="1" Margin="1.5,0">
                                <TextBox x:Name="SeekTime" Width="148" Padding="8,0" BorderThickness="0" Background="Transparent" TextAlignment="Center"
                                         VerticalContentAlignment="Center" FontFamily="Consolas" FontWeight="SemiBold" FontSize="18" Text="00:00:00.000"
                                         AutomationProperties.Name="当前时间" KeyDown="SeekKeyDown" ToolTip="输入时间或秒数，按 Enter 定位" />
                            </Border>
                            <Button x:Name="ForwardOne" Style="{StaticResource Step}" Content="+1" ContentTemplate="{StaticResource StepText}" Click="StepFrame" Tag="1" ToolTip="前进一帧" />
                            <Button x:Name="ForwardFive" Style="{StaticResource Step}" Content="+5" ContentTemplate="{StaticResource StepText}" Click="StepFrame" Tag="5" ToolTip="前进五帧" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
        <Border Grid.Row="1" BorderBrush="{StaticResource Divider}" BorderThickness="0,1,0,0" Background="{StaticResource MediaWell}">
            <ScrollViewer x:Name="GalleryScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <ItemsControl x:Name="Gallery" Margin="10,6,10,10" AutomationProperties.Name="候选帧">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate>
                        <UniformGrid Columns="{Binding GalleryColumns, RelativeSource={RelativeSource AncestorType=Window}}" />
                    </ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Click="ToggleCandidate" Style="{StaticResource Tile}" IsEnabled="{Binding CanToggle}"
                                    AutomationProperties.Name="{Binding AccessibilityLabel}" ToolTip="{Binding AccessibilityLabel}">
                                <Grid Height="{Binding GalleryHeight, RelativeSource={RelativeSource AncestorType=Window}}">
                                    <Border CornerRadius="8">
                                        <Border.Background><ImageBrush ImageSource="{Binding Image}" Stretch="Uniform" /></Border.Background>
                                    </Border>
                                    <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="6" Padding="7,4"
                                            Background="#B8000000" CornerRadius="4">
                                        <TextBlock Text="{Binding Timecode}" FontFamily="Consolas" FontSize="10" FontWeight="SemiBold" Foreground="White" />
                                    </Border>
                                    <Border Width="36" Height="36" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8">
                                        <Grid>
                                            <Ellipse Width="24" Height="24" Stroke="#EBFFFFFF" StrokeThickness="1.5" Fill="#33000000" />
                                            <Grid Visibility="{Binding IsSelected, Converter={StaticResource VisibleWhen}}">
                                                <Ellipse Stroke="White" StrokeThickness="2" Fill="{StaticResource Accent}" />
                                                <TextBlock Text="{Binding Number}" FontSize="{Binding BadgeFont}" FontWeight="Bold" Foreground="White"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Height="18" Padding="6,0"
                                            BorderBrush="#80FFFFFF" BorderThickness="1" Background="#FFF0C7" CornerRadius="5"
                                            Visibility="{Binding IsManual, Converter={StaticResource VisibleWhen}}">
                                        <TextBlock Text="手动" FontSize="9" FontWeight="SemiBold" Foreground="#6E4508" VerticalAlignment="Center" />
                                    </Border>
                                    <Border CornerRadius="8" BorderBrush="{StaticResource Divider}" BorderThickness="1" IsHitTestVisible="False" />
                                    <Grid Visibility="{Binding IsSelected, Converter={StaticResource VisibleWhen}}" IsHitTestVisible="False">
                                        <Border CornerRadius="8" BorderBrush="{StaticResource Accent}" BorderThickness="3" />
                                        <Border CornerRadius="5" BorderBrush="#EBFFFFFF" BorderThickness="1" Margin="3" />
                                    </Grid>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
