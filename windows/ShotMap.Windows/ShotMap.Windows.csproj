<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>ShotMap</AssemblyName>
    <Version>0.1.0-preview.2</Version>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>../../website/favicon.ico</ApplicationIcon>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../ShotMap.Core/ShotMap.Core.csproj" />
    <Resource Include="../../website/assets/app-icon.png" Link="Brand.png" />
  </ItemGroup>
</Project>
